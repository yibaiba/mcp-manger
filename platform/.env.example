# cp .env.example .env; generate secrets with the commands in README.md.
DATABASE_URL=postgresql://platform:CHANGE_LOCALLY@localhost:5432/platform
PUBLIC_URL=http://localhost:4300
WEB_ORIGIN=http://localhost:4301
PORT=4300
# MCP Apps share the application endpoint using an opaque browser sandbox.
DATA_DIR=.data
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
# Independent 32-byte canonical Base64 key; protect and back up separately.
DEVICE_AUTH_ENCRYPTION_KEY=
ALLOW_REGISTRATION=false
# Enables built-in inference tasks only. MCP connections and Pi bridging need no model.
PI_ENABLED=false
PI_MODEL_PROVIDER=
PI_MODEL_ID=
PI_MCP_ADAPTER_OAUTH_FILE_KEY=
# Production behind your Nginx: PUBLIC_URL and WEB_ORIGIN are the same HTTPS origin.
POSTGRES_PASSWORD=
